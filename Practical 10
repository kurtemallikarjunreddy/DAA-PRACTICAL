
# Kruskal's Algorithm in Python

V = 5

edges = [
    (2, 0, 1),
    (3, 1, 2),
    (6, 0, 3),
    (8, 1, 3),
    (5, 1, 4),
    (7, 2, 4),
    (9, 3, 4)
]

parent = list(range(V))

def find(i):
    if parent[i] == i:
        return i
    parent[i] = find(parent[i])
    return parent[i]

def union(i, j):
    parent[find(i)] = find(j)

edges.sort()
total = 0
count = 0

print("Edge : Weight")

for weight, u, v in edges:
    if find(u) != find(v):
        union(u, v)
        print(u, "-", v, ":", weight)
        total += weight
        count += 1

        if count == V - 1:
            break

print("Total weight of MST:", total)
