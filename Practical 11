
# Floyd-Warshall Algorithm

INF = float('inf')

dist = [
    [0,   5,   INF, 10],
    [INF, 0,   3,   INF],
    [INF, INF, 0,   1],
    [INF, INF, INF, 0]
]

V = len(dist)

for k in range(V):
    for i in range(V):
        for j in range(V):
            dist[i][j] = min(
                dist[i][j],
                dist[i][k] + dist[k][j]
            )

print("Shortest distance matrix:")

for row in dist:
    print(row)
