# Prim's Algorithm in Python

INF = 9999999
V = 5

G = [
    [0, 2, 0, 6, 0],
    [2, 0, 3, 8, 5],
    [0, 3, 0, 0, 7],
    [6, 8, 0, 0, 9],
    [0, 5, 7, 9, 0]
]

selected = [False] * V
selected[0] = True

print("Edge : Weight")
count = 0
total = 0

while count < V - 1:
    minimum = INF
    x = 0
    y = 0

    for i in range(V):
        if selected[i]:
            for j in range(V):
                if not selected[j] and G[i][j] != 0:
                    if G[i][j] < minimum:
                        minimum = G[i][j]
                        x = i
                        y = j

    print(x, "-", y, ":", G[x][y])
    total += G[x][y]
    selected[y] = True
    count += 1

print("Total weight of MST:", total)
